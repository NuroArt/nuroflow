# --------------------------------------------------------------------------- #
# NuroFlow configuration. Copy to backend/.env for local development:
#     cp .env.example backend/.env
# Every variable uses the NUROFLOW_ prefix. Real environment variables override .env.
# NEVER commit a real .env file.
# --------------------------------------------------------------------------- #

# ---- Phase 1: runtime + database ------------------------------------------ #
NUROFLOW_ENVIRONMENT=local                # local | test | staging | production
NUROFLOW_DATABASE_URL=postgresql+psycopg://nuroflow:nuroflow@localhost:5432/nuroflow
NUROFLOW_DATABASE_POOL_SIZE=10
NUROFLOW_DATABASE_MAX_OVERFLOW=10
NUROFLOW_DATABASE_ECHO=false              # true = log every SQL statement

NUROFLOW_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
NUROFLOW_LOG_JSON=false                   # true when deployed (one JSON object per line)

# ---- Phase 2: API, auth, rate limiting ------------------------------------ #
NUROFLOW_REDIS_URL=redis://localhost:6379/0
# Root secret. JWT and API-key keys are derived from it. The dev default is REJECTED
# in staging/production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUROFLOW_SECRET_KEY=
NUROFLOW_ACCESS_TOKEN_TTL_SECONDS=900     # 15 minutes
NUROFLOW_REFRESH_TOKEN_TTL_SECONDS=1209600  # 14 days
NUROFLOW_REGISTRATION_ENABLED=true        # set false in production; create users via admin
NUROFLOW_PASSWORD_MIN_LENGTH=12
NUROFLOW_CORS_ORIGINS=http://localhost:5173  # comma-separated
NUROFLOW_DOCS_ENABLED=true                # /docs and /openapi.json
NUROFLOW_LOGIN_MAX_ATTEMPTS_PER_IDENTITY=10
NUROFLOW_LOGIN_MAX_ATTEMPTS_PER_IP=50
NUROFLOW_LOGIN_WINDOW_SECONDS=300

# ---- Phase 3+: credentials encryption (not read yet) ---------------------- #
# NUROFLOW_ENCRYPTION_KEYS=               # comma-separated Fernet keys, newest first (rotation)

# ---- Phase 5: integrations (not read yet) --------------------------------- #
# NUROFLOW_OPENAI_API_KEY=
# NUROFLOW_ANTHROPIC_API_KEY=
# NUROFLOW_TELEGRAM_BOT_TOKEN=
