# --------------------------------------------------------------------------- #
# NuroFlow configuration. Copy to backend/.env for local development:
#     cp .env.example backend/.env
# Every variable uses the NUROFLOW_ prefix. Real environment variables override .env.
# NEVER commit a real .env file.
# --------------------------------------------------------------------------- #

# ---- Phase 1: runtime + database ------------------------------------------ #
NUROFLOW_ENVIRONMENT=local                # local | test | staging | production
NUROFLOW_DATABASE_URL=postgresql+psycopg://nuroflow:nuroflow@localhost:5432/nuroflow
NUROFLOW_DATABASE_POOL_SIZE=10
NUROFLOW_DATABASE_MAX_OVERFLOW=10
NUROFLOW_DATABASE_ECHO=false              # true = log every SQL statement

NUROFLOW_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
NUROFLOW_LOG_JSON=false                   # true when deployed (one JSON object per line)

# ---- Phase 2: API, auth, rate limiting ------------------------------------ #
NUROFLOW_REDIS_URL=redis://localhost:6379/0
# Root secret. JWT and API-key keys are derived from it. The dev default is REJECTED
# in staging/production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# NUROFLOW_SECRET_KEY=
NUROFLOW_ACCESS_TOKEN_TTL_SECONDS=900     # 15 minutes
NUROFLOW_REFRESH_TOKEN_TTL_SECONDS=1209600  # 14 days
NUROFLOW_REGISTRATION_ENABLED=true        # set false in production; create users via admin
NUROFLOW_PASSWORD_MIN_LENGTH=12
NUROFLOW_CORS_ORIGINS=http://localhost:5173  # comma-separated
NUROFLOW_DOCS_ENABLED=true                # /docs and /openapi.json
NUROFLOW_LOGIN_MAX_ATTEMPTS_PER_IDENTITY=10
NUROFLOW_LOGIN_MAX_ATTEMPTS_PER_IP=50
NUROFLOW_LOGIN_WINDOW_SECONDS=300

# ---- Phase 3: workflow engine & workers ----------------------------------- #
# NUROFLOW_CELERY_BROKER_URL=             # defaults to NUROFLOW_REDIS_URL
NUROFLOW_WORKER_CONCURRENCY=4
NUROFLOW_WORKER_QUEUES=default,ai,notifications
NUROFLOW_TASK_OUTPUT_MAX_BYTES=262144     # 256 KB per task output
NUROFLOW_TASK_HEARTBEAT_INTERVAL_SECONDS=15
NUROFLOW_HTTP_ALLOW_PRIVATE_NETWORKS=false  # SSRF guard; rejected when deployed if true

# ---- Phase 4: scheduler, events, webhooks ---------------------------------- #
NUROFLOW_PUBLIC_BASE_URL=http://localhost:8000   # used in webhook URLs
NUROFLOW_SCHEDULER_TICK_SECONDS=2
NUROFLOW_SCHEDULER_BATCH_SIZE=100
NUROFLOW_CRON_MAX_CATCHUP_RUNS=50
NUROFLOW_REAPER_QUEUED_TIMEOUT_SECONDS=600
NUROFLOW_REAPER_HEARTBEAT_TIMEOUT_SECONDS=90     # >= 3x heartbeat interval
NUROFLOW_WEBHOOK_TOLERANCE_SECONDS=300
NUROFLOW_EVENT_RATE_LIMIT_PER_MINUTE=600
NUROFLOW_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# Fernet keys for secrets at rest, newest first (rotation). Empty = derived from SECRET_KEY.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUROFLOW_ENCRYPTION_KEYS=

# ---- Phase 5: integrations ------------------------------------------------- #
# simulated = deterministic fakes for every LLM/Telegram call: no keys, no cost.
# Switch to live once keys are set. Staging/production REJECT simulated.
NUROFLOW_LLM_MODE=simulated               # live | simulated
NUROFLOW_TELEGRAM_MODE=simulated          # live | simulated
# Platform-wide default credentials, used when a task names no `connection:`.
# Per-user keys belong in connections instead (POST /api/v1/connections, encrypted).
# NUROFLOW_OPENAI_API_KEY=
# NUROFLOW_ANTHROPIC_API_KEY=
# NUROFLOW_TELEGRAM_BOT_TOKEN=
# NUROFLOW_OPENAI_BASE_URL=https://api.openai.com/v1      # any OpenAI-compatible server
# NUROFLOW_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
NUROFLOW_LLM_TIMEOUT_SECONDS=60
# USD per 1M tokens, longest model-prefix match wins. Prices change: check the provider's
# pricing page. Unpriced models still record tokens.
# NUROFLOW_LLM_PRICING={"gpt-4o-mini": {"input": 0.15, "output": 0.60}}
NUROFLOW_NOTIFICATION_MAX_ATTEMPTS=5

# ---- Phase 6: observability ------------------------------------------------ #
NUROFLOW_METRICS_ENABLED=true             # GET /metrics on the API
# Bearer token Prometheus must send. REQUIRED when deployed (metrics reveal traffic and spend).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUROFLOW_METRICS_TOKEN=
NUROFLOW_WORKER_METRICS_PORT=9101         # worker /metrics (aggregates prefork children); 0 = off
NUROFLOW_SCHEDULER_METRICS_PORT=9102      # scheduler /metrics; 0 = off
NUROFLOW_SSE_POLL_SECONDS=1               # how often live streams check for changes
NUROFLOW_SSE_MAX_STREAM_SECONDS=1800      # streams end after 30 min; clients resume via Last-Event-ID
